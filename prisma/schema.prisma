generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model GeographicalArea {
  id         String             @id @default(cuid())
  name       String
  code       String?            @unique
  parentId   String?
  parent     GeographicalArea?  @relation("GAHierarchy", fields: [parentId], references: [id])
  children   GeographicalArea[] @relation("GAHierarchy")
  customers  Customer[]
  createdAt  DateTime           @default(now())
}

enum CustomerCategory {
  INDUSTRIAL
  COMMERCIAL
  RESIDENTIAL
  DRS
}

model Customer {
  id           String            @id @default(cuid())
  name         String
  category     CustomerCategory
  address      String?
  gaId         String
  ga           GeographicalArea  @relation(fields: [gaId], references: [id])
  devices      Device[]
  createdAt    DateTime          @default(now())

  @@index([gaId])
  @@index([category])
}

model Device {
  id                   String    @id @default(cuid())
  deviceSerialNo       String    @unique
  customerId           String?
  customer             Customer? @relation(fields: [customerId], references: [id])

  meterSerialNo        String?
  meterSize            String?
  firmwareVersion      String?
  hardwareVersion      String?
  deviceModel          String?
  configurationVersion String?

  latitude             Float?
  longitude            Float?

  pressureUpperLimit      Float?
  pressureLowerLimit      Float?
  temperatureUpperLimit   Float?
  temperatureLowerLimit   Float?
  consumptionUpperLimit   Float?
  consumptionLowerLimit   Float?
  batteryLowerLimit       Float?

  firstSeenAt          DateTime  @default(now())
  lastSeenAt           DateTime?

  readings             Reading[]
  alarms               Alarm[]

  @@index([customerId])
}

model Reading {
   id                  String   @id @default(cuid())
   deviceId            String
   device              Device   @relation(fields: [deviceId], references: [id])
   readingDate         DateTime

   correctedVolumeVb   Float?
   uncorrectedVolumeVm Float?
   gasPressure         Float?
   pressureMax         Float?
   pressureMin         Float?
   gasTemperature      Float?
   temperatureMax      Float?
   temperatureMin      Float?
   compressibilityZ    Float?
   compressibilityFpv  Float?
   correctionFactorC   Float?
   gasDensity          Float?
   hourlyConsumption   Json?

   batteryLevel        Float?
   currentFlowRate     Float?

   rawPayload          Json
   receivedAt          DateTime @default(now())

  // No longer unique — every push is now its own row (deviceId+readingDate
  // can repeat). Index kept (now non-unique) since every read-path query
  // still filters/sorts by these two columns to find "the latest push for
  // this device/day" — see features/devices/service.ts and
  // features/ingest/alarm-check.ts.
  @@index([deviceId, readingDate])
  @@index([readingDate])
 }

enum AlarmType {
  MISSING_DATA
  GAS_OUT_OF_RANGE
  PRESSURE_OUT_OF_RANGE
  TEMPERATURE_OUT_OF_RANGE
  CONSUMPTION_OUT_OF_RANGE
  BATTERY_LOW
}

enum AlarmSeverity {
  CRITICAL
  WARNING
}

enum AlarmStatus {
  OPEN
  RESOLVED
}

model Alarm {
  id             String        @id @default(cuid())
  deviceId       String
  device         Device        @relation(fields: [deviceId], references: [id])
  type           AlarmType
  severity       AlarmSeverity
  cause          String
  gasValue       Float?
  averageValue   Float?
  forDate        DateTime
  status         AlarmStatus   @default(OPEN)
  acknowledged   Boolean       @default(false)
  createdAt      DateTime      @default(now())

  @@unique([deviceId, type, forDate])
  @@index([status, createdAt])
  @@index([severity, status])
  @@index([acknowledged])
}

model AlarmSettings {
  id                       String   @id @default("singleton")
  gasDeviationWindowDays   Int      @default(7)
  gasDeviationPercent      Float    @default(20)
  updatedAt                DateTime @updatedAt
}

model SystemSettings {
  id                     String   @id @default("singleton")
  maxMeterCapacity       Int?
  alarmNotificationEmail String?
  updatedAt              DateTime @updatedAt
}

model RejectedConnectionAttempt {
  id             String   @id @default(cuid())
  deviceSerialNo String
  rawPayload     Json
  attemptedAt    DateTime @default(now())
  acknowledged   Boolean  @default(false)

  @@index([acknowledged, attemptedAt])
}
