generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("DIRECT_URL")
}

model GeographicalArea {
  id        String             @id @default(cuid())
  name      String
  code      String?            @unique
  parentId  String?
  createdAt DateTime           @default(now())
  customers Customer[]
  users     User[]
  parent    GeographicalArea?  @relation("GAHierarchy", fields: [parentId], references: [id])
  children  GeographicalArea[] @relation("GAHierarchy")
}

model User {
  id           String              @id @default(cuid())
  email        String              @unique
  username     String              @unique
  passwordHash String
  gaId         String
  role         UserRole            @default(USER)
  createdAt    DateTime            @default(now())
  ga           GeographicalArea    @relation(fields: [gaId], references: [id], onDelete: Restrict)
  sessions     AuthSession[]

  @@index([gaId])
}

enum UserRole {
  USER
  ADMIN
}

model AuthSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model AuthRateLimit {
  key         String   @id
  attempts    Int      @default(0)
  windowStart DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([updatedAt])
}

model Customer {
  id        String           @id @default(cuid())
  name      String
  address   String?
  gaId      String
  createdAt DateTime         @default(now())
  ga        GeographicalArea @relation(fields: [gaId], references: [id])
  devices   Device[]

  @@index([gaId])
}

model Device {
  id                    String    @id @default(cuid())
  deviceSerialNo        String    @unique
  customerId            String?
  category              CustomerCategory?
  meterSerialNo         String?
  meterSize             String?
  firmwareVersion       String?
  hardwareVersion       String?
  deviceModel           String?
  configurationVersion  String?
  latitude              Float?
  longitude             Float?
  firstSeenAt           DateTime  @default(now())
  lastSeenAt            DateTime?
  batteryLowerLimit     Float?
  consumptionLowerLimit Float?
  consumptionUpperLimit Float?
  pressureLowerLimit    Float?
  pressureUpperLimit    Float?
  temperatureLowerLimit Float?
  temperatureUpperLimit Float?
  alarms                Alarm[]
  customer              Customer? @relation(fields: [customerId], references: [id])
  readings              Reading[]

  @@index([customerId])
}

model Reading {
  id                  String   @id @default(cuid())
  deviceId            String
  readingDate         DateTime
  correctedVolumeVb   Float?
  uncorrectedVolumeVm Float?
  gasPressure         Float?
  pressureMax         Float?
  pressureMin         Float?
  gasTemperature      Float?
  temperatureMax      Float?
  temperatureMin      Float?
  compressibilityZ    Float?
  compressibilityFpv  Float?
  correctionFactorC   Float?
  gasDensity          Float?
  hourlyConsumption   Json?
  batteryLevel        Float?
  currentFlowRate     Float?
  rawPayload          Json
  receivedAt          DateTime @default(now())
  device              Device   @relation(fields: [deviceId], references: [id])

  @@index([deviceId, readingDate])
  @@index([readingDate])
}

model Alarm {
  id             String        @id @default(cuid())
  deviceId       String
  type           AlarmType
  severity       AlarmSeverity
  cause          String
  gasValue       Float?
  averageValue   Float?
  forDate        DateTime
  status         AlarmStatus   @default(OPEN)
  acknowledged   Boolean       @default(false)
  createdAt      DateTime      @default(now())
  acknowledgedAt DateTime?
  device         Device        @relation(fields: [deviceId], references: [id])

  @@unique([deviceId, type, forDate])
  @@index([status, createdAt])
  @@index([severity, status])
  @@index([acknowledged])
}

model AlarmSettings {
  id                     String   @id @default("singleton")
  gasDeviationWindowDays Int      @default(7)
  gasDeviationPercent    Float    @default(20)
  updatedAt              DateTime @updatedAt
}

model SystemSettings {
  id                     String   @id @default("singleton")
  maxMeterCapacity       Int?
  updatedAt              DateTime @updatedAt
  alarmNotificationEmail String?
  reportScheduleTime     String?  @default("07:00")
}

model RejectedConnectionAttempt {
  id             String   @id @default(cuid())
  deviceSerialNo String
  rawPayload     Json
  attemptedAt    DateTime @default(now())
  acknowledged   Boolean  @default(false)

  @@index([acknowledged, attemptedAt])
}

enum CustomerCategory {
  COMMERCIAL
  RESIDENTIAL
  DRS
  INDUSTRIAL_CNG
  INDUSTRIAL_PNG
}

enum AlarmType {
  MISSING_DATA
  GAS_OUT_OF_RANGE
  PRESSURE_OUT_OF_RANGE
  TEMPERATURE_OUT_OF_RANGE
  CONSUMPTION_OUT_OF_RANGE
  BATTERY_LOW
  NO_CONSUMPTION
  METER_FAILURE
}

enum AlarmSeverity {
  CRITICAL
  WARNING
}

enum AlarmStatus {
  OPEN
  RESOLVED
}
